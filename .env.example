# 이 파일을 복사해서 .env 로 저장한 뒤 실제 인증키를 채워 넣으세요.
# .env는 절대 커밋/공유하지 마세요 (.gitignore에 이미 등록되어 있습니다).

# 공공데이터포털 - 전국청소년수련시설표준데이터
# https://www.data.go.kr/data/15129449/standard.do 에서 활용신청
YOUTH_FACILITY_API_KEY=
YOUTH_FACILITY_API_URL=https://api.data.go.kr/openapi/tn_pubr_public_teen_training_fclt_api

# 공공데이터포털 - 청소년상담복지센터 현황
# 정확한 요청 URL은 데이터셋을 활용신청한 뒤 상세기능정보 페이지에서
# 직접 복사해서 아래에 붙여넣어야 합니다(자동 생성 API 주소에 데이터셋별
# 고유 식별자가 포함되어 있어 미리 알 수 없습니다).
COUNSELING_CENTER_API_KEY=
COUNSELING_CENTER_API_URL=

# 도서관정보나루 (data4library.kr)
# https://www.data4library.kr 에서 발급
LIBRARY_API_KEY=

# 행정안전부 - 주민등록 인구통계 (공공정보 접근성 등급 계산에 사용)
# 정확한 요청 URL은 데이터셋을 활용신청한 뒤 상세기능정보 페이지에서
# 직접 복사해서 아래에 붙여넣어야 합니다.
POPULATION_API_KEY=
POPULATION_API_URL=

# 네이버 뉴스 검색 API (최신기사 화면)
# https://developers.naver.com 애플리케이션에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Supabase (서버 전용 - 절대 브라우저로 노출 금지)
# 지역 이슈 자동 발견 기능이 관리자 인증 확인과 승인 대기 큐 저장에
# 사용한다. URL은 비밀이 아니며 assets/js/supabase-client.js의 값과
# 같다. SERVICE_ROLE_KEY는 Project Settings > API 에서 발급받는다 -
# RLS를 우회하는 강력한 키이므로 절대 브라우저 코드에 넣지 마세요.
SUPABASE_URL=https://ahgspgxwbbjwiyosevzm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 서버 포트 (선택, 기본값 3000)
PORT=3000
